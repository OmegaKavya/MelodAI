# macOS
.DS_Store
.AppleDouble
.LSOverride

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
*.egg
*.eggs/
build/
dist/
pip-wheel-metadata/
.venv/
# Any venv, not only one named exactly ".venv". The YAMNet work needs
# tensorflow_hub, which pulls plain tensorflow and conflicts with the
# tensorflow-macos plus metal pair the main environment uses, so it lives in
# .venv-yamnet inside the repo.
.venv*/
venv/
env/
ENV/
.python-version
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# IDE/editor
.vscode/
.idea/

# Logs and caches
*.log
logs/
.cache/

# Environment/secrets
.env
.env.*

# Project data and generated artifacts
# Raw audio and derived spectrograms are large; keep them out of git
/data/
/mel_spectrograms_*/
/mel_spectrograms_resized/
/mel_spectrograms_enhanced/
/mel_spectrograms_fusion/

# Models and training artifacts
/models/*.h5
# The two shipped models are the exception, tracked through LFS. Experiment
# checkpoints stay local; these are what the app and the docs refer to.
!/models/best_model.h5
!/models/best_model_transfer.h5
/models/*.hdf5
/models/*.keras
/models/training_log.csv

# Media downloads
*.mp3
*.wav
*.webm
*.mp4
*.part

# Temporary files
/tmp/
/temp/
/models/yamnet_embeddings.npz
